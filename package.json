{
  "name": "@local/dsh-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explicit, scoped long-term memory for DSH profiles",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "store.js", "search.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.1 <0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.1 <0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "test": "node --test test/*.test.js" }
}
